# Project Configuration
PROJECT_NAME=plateau
# Fallback version used when no git tags are present (no .git or clean repo).
# The actual build version is always derived from `git describe` at build time.
SERVICE_APP_VERSION=0.0.1

# PostgreSQL bootstrap database, service database and IAM owner/runtime role.
POSTGRES_DB=plateau
POSTGRES_SERVICE_DATABASES=plateau_iam
IAM_DATABASE_NAME=plateau_iam
IAM_DATABASE_ROLE=plateau_iam_app
IAM_DATABASE_PASSWORD=plateau_iam_pwd

# Local IAM service dependencies.
IAM_DATABASE_SOURCE=postgres://plateau_iam_app:plateau_iam_pwd@localhost:5432/plateau_iam?sslmode=disable
IAM_REDIS_ADDR=localhost:6379
IAM_REDIS_PASSWORD=servora_redis_pwd
IAM_SMTP_HOST=localhost
IAM_PUBLIC_ORIGIN=http://localhost:8000

# Canonical OpenFGA environment shared by model scripts and IAM.
FGA_API_URL=http://localhost:18080
FGA_STORE_ID=
FGA_MODEL_ID=
